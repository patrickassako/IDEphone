# Backend Proxy Configuration
# Replace with your deployed Vercel URL after deployment

# CodeSandbox Proxy (for quick preview with embed)
EXPO_PUBLIC_CODESANDBOX_PROXY_URL=https://idephone.vercel.app/api/codesandbox-proxy

# Vercel Deployment API (for permanent project URLs like Lovable.dev)
EXPO_PUBLIC_VERCEL_DEPLOYMENT_URL=https://idephone.vercel.app/api/deploy-to-vercel

# For local development with ngrok:
# EXPO_PUBLIC_CODESANDBOX_PROXY_URL=https://your-ngrok-id.ngrok.io/api/codesandbox-proxy
# EXPO_PUBLIC_VERCEL_DEPLOYMENT_URL=https://your-ngrok-id.ngrok.io/api/deploy-to-vercel
